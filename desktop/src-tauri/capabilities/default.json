{
  "identifier": "default",
  "description": "Default capabilities for Silex desktop",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://localhost:*",
      "http://127.0.0.1:*"
    ]
  },
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-emit",
    "core:window:default",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-set-size",
    "core:window:allow-center",
    "dialog:default",
    "allow-set-current-project",
    "allow-clear-current-project",
    "allow-set-unsaved",
    "allow-open-link",
    "allow-show-website-folder",
    "allow-trash-website",
    "allow-create-website-from-template",
    "allow-saved-everything",
    "allow-get-telemetry-context"
  ]
}
