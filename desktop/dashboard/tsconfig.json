{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client"
    ],
    "verbatimModuleSyntax": true,
    "paths": {
      "~/common/*": [
        "../../common/*"
      ],
      "~/editor/*": [
        "../../editor/*"
      ],
      "~/public/*": [
        "../../public/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "vite.config.ts"
  ]
}
